@model IEnumerable<Fitessa.Data.Entities.SubscriptionPlan>
@{
    ViewData["Title"] = "Payment Plans";
    var user = ViewBag.User as Fitessa.Data.Entities.ApplicationUser;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-5">
                <h1 class="display-4">Choose Your Premium Plan</h1>
                <p class="lead">Unlock advanced features and transform your fitness journey</p>
            </div>

            <div class="row">
                @foreach (var plan in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card h-100 shadow @(plan.Id == 2 ? "border-primary" : "")">
                            @if (plan.Id == 2)
                            {
                                <div class="card-header bg-primary text-white text-center">
                                    <span class="badge bg-warning">MOST POPULAR</span>
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-center">@plan.Name</h5>
                                <div class="text-center mb-3">
                                    <span class="display-6 text-primary">$@plan.Price</span>
                                    <span class="text-muted">/@(plan.DurationDays == 1 ? "CLASS" : plan.DurationDays + " DAYS")</span>
                                </div>
                                <p class="card-text text-center mb-4">@plan.Description</p>
                                
                                <ul class="list-unstyled mb-4">
                                    <li class="mb-2">
                                        <i class="fas fa-check text-success me-2"></i>
                                        Access to all workout programs
                                    </li>
                                    <li class="mb-2">
                                        <i class="fas fa-check text-success me-2"></i>
                                        Personalized meal plans
                                    </li>
                                    <li class="mb-2">
                                        <i class="fas fa-check text-success me-2"></i>
                                        Progress tracking & analytics
                                    </li>
                                    <li class="mb-2">
                                        <i class="fas fa-check text-success me-2"></i>
                                        24/7 customer support
                                    </li>
                                    <li class="mb-2">
                                        <i class="fas fa-check text-success me-2"></i>
                                        No time restrictions
                                    </li>
                                    <li class="mb-2">
                                        <i class="fas fa-check text-success me-2"></i>
                                        Personal trainer guidance
                                    </li>
                                </ul>
                                
                                <div class="mt-auto">
                                    <a href="@Url.Action("Checkout", "Payment", new { planId = plan.Id })" 
                                       class="btn btn-primary w-100">
                                        <i class="fas fa-credit-card me-2"></i>Subscribe Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="row mt-5">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="fas fa-shield-alt me-2"></i>Secure Payment</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Payment Security</h6>
                                    <ul class="list-unstyled">
                                        <li><i class="fas fa-lock text-success me-2"></i>SSL Encrypted Transactions</li>
                                        <li><i class="fas fa-shield-alt text-success me-2"></i>PCI DSS Compliant</li>
                                        <li><i class="fas fa-user-shield text-success me-2"></i>Data Protection</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h6>Accepted Payment Methods</h6>
                                    <div class="d-flex align-items-center">
                                        <i class="fab fa-cc-visa text-primary me-2" style="font-size: 2rem;"></i>
                                        <i class="fab fa-cc-mastercard text-warning me-2" style="font-size: 2rem;"></i>
                                        <i class="fab fa-cc-amex text-info me-2" style="font-size: 2rem;"></i>
                                        <i class="fab fa-cc-discover text-success me-2" style="font-size: 2rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 