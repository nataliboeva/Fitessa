@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow text-center">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="text-success mb-3">Payment Successful!</h1>
                    <p class="lead mb-4">Thank you for subscribing to Fitessa Premium. Your payment has been processed successfully.</p>
                    
                    <div class="alert alert-info">
                        <i class="fas fa-envelope me-2"></i>
                        <strong>Confirmation Email:</strong> We've sent a confirmation email with your subscription details.
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-tachometer-alt me-2"></i>Go to Dashboard
                            </a>
                        </div>
                        <div class="col-md-6 mb-3">
                            <a href="@Url.Action("Index", "WorkoutPrograms")" class="btn btn-outline-primary btn-lg w-100">
                                <i class="fas fa-dumbbell me-2"></i>Start Working Out
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 