@model Fitessa.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Welcome back, @Model.User.FirstName!</h1>
        <div>
            <a href="@Url.Action("Analytics", "Dashboard")" class="btn btn-primary btn-sm">
                <i class="fas fa-chart-line"></i> View Analytics
            </a>
            <a href="@Url.Action("Goals", "Dashboard")" class="btn btn-success btn-sm">
                <i class="fas fa-bullseye"></i> Manage Goals
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Welcome</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">Dashboard</div>
                            <div class="text-xs text-muted">Your Fitness Journey</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dumbbell fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Workouts</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model.RecentWorkoutPrograms?.Count ?? 0)</div>
                            <div class="text-xs text-muted">Recent Programs</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-running fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Meal Plans</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model.RecentMealPlans?.Count ?? 0)</div>
                            <div class="text-xs text-muted">Recent Plans</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-utensils fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Progress</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@(Model.RecentProgressLogs?.Count ?? 0)</div>
                            <div class="text-xs text-muted">Recent Logs</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-line fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Activity</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Recent Workouts</h6>
                            @if (Model.RecentWorkoutPrograms?.Any() == true)
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var workout in Model.RecentWorkoutPrograms)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@workout.Name</strong>
                                                <br><small class="text-muted">@workout.Difficulty • @workout.DurationDays days</small>
                                            </div>
                                            <a href="@Url.Action("Details", "WorkoutPrograms", new { id = workout.Id })" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No recent workouts. <a href="@Url.Action("Index", "WorkoutPrograms")">Start your first workout!</a></p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6>Recent Meal Plans</h6>
                            @if (Model.RecentMealPlans?.Any() == true)
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var mealPlan in Model.RecentMealPlans)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@mealPlan.Name</strong>
                                                <br><small class="text-muted">@mealPlan.Description</small>
                                            </div>
                                            <a href="@Url.Action("Details", "MealPlans", new { id = mealPlan.Id })" 
                                               class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No recent meal plans. <a href="@Url.Action("Index", "MealPlans")">Create your first meal plan!</a></p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Create", "WorkoutPrograms")" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Create Workout
                        </a>
                        <a href="@Url.Action("Create", "MealPlans")" class="btn btn-success">
                            <i class="fas fa-utensils"></i> Create Meal Plan
                        </a>
                        <a href="@Url.Action("Create", "MeasurementLogs")" class="btn btn-info">
                            <i class="fas fa-chart-bar"></i> Log Progress
                        </a>
                        <a href="@Url.Action("Index", "Exercises")" class="btn btn-warning">
                            <i class="fas fa-running"></i> Browse Exercises
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>



    @if (Model.RecentProgressLogs?.Any() == true)
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Recent Progress</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Weight (kg)</th>
                                        <th>Height (cm)</th>
                                        <th>Body Fat %</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RecentProgressLogs)
                                    {
                                        <tr>
                                            <td>@log.LoggedAt.ToString("MMM dd, yyyy")</td>
                                            <td>@log.WeightKg kg</td>
                                            <td>@log.HeightCm cm</td>
                                            <td>-</td>
                                            <td>-</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div> 