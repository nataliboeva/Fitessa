@model IEnumerable<Fitessa.Data.Entities.WorkoutProgram>

<div class="row">
    @foreach (var program in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 workout-card">
                <div class="card-body">
                    <h5 class="card-title">@program.Name</h5>
                    <p class="card-text">@program.Description</p>
                    <div class="workout-meta">
                        <span class="badge bg-primary me-2">@program.Difficulty</span>
                        <span class="badge bg-info">@program.DurationDays days</span>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Details", "WorkoutPrograms", new { id = program.Id })" 
                       class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-info-circle me-1"></i>Details
                    </a>
                    <button onclick="exportWorkoutProgram(@program.Id)" 
                            class="btn btn-outline-success btn-sm">
                        <i class="fas fa-download me-1"></i>Export
                    </button>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Edit", "WorkoutPrograms", new { id = program.Id })" 
                           class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-dumbbell fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">No workout programs found</h5>
        <p class="text-muted">Try adjusting your filter criteria</p>
    </div>
} 