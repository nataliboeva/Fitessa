@model IEnumerable<Fitessa.Data.Entities.WorkoutProgram>
@{
    ViewData["Title"] = "Workout Programs";
}
<h2>Workout Programs</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Create New Workout Program</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Difficulty</th>
            <th>Duration (days)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>@item.Difficulty</td>
            <td>@item.DurationDays</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> |
                <a asp-action="ExportToPdf" asp-route-id="@item.Id" class="btn">Export to PDF</a>
            </td>
        </tr>
    }
    </tbody>
</table> 