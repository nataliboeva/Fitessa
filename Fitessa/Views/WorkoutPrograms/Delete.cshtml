@model Fitessa.Data.Entities.WorkoutProgram
@{
    ViewData["Title"] = "Delete Workout Program";
}
<h2>Delete Workout Program</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>@Model.Name</h4>
    <div><strong>Description:</strong> @Model.Description</div>
    <div><strong>Difficulty:</strong> @Model.Difficulty</div>
    <div><strong>Duration (days):</strong> @Model.DurationDays</div>
</div>
<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form> 