@model Fitessa.Data.Entities.WorkoutProgram
@{
    ViewData["Title"] = "Create Workout Program";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-dumbbell me-2"></i>
                        Create New Workout Program
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">
                                        <i class="fas fa-tag me-1"></i>Program Name
                                    </label>
                                    <input asp-for="Name" class="form-control form-control-lg" placeholder="Enter program name..." />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Difficulty" class="form-label fw-bold">
                                        <i class="fas fa-signal me-1"></i>Difficulty Level
                                    </label>
                                    <select asp-for="Difficulty" class="form-select form-select-lg">
                                        <option value="">Select difficulty...</option>
                                        <option value="Beginner">Beginner</option>
                                        <option value="Intermediate">Intermediate</option>
                                        <option value="Advanced">Advanced</option>
                                    </select>
                                    <span asp-validation-for="Difficulty" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label fw-bold">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="4" 
                                      placeholder="Describe your workout program goals, target muscle groups, and any special instructions..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="DurationDays" class="form-label fw-bold">
                                <i class="fas fa-calendar me-1"></i>Duration (Days)
                            </label>
                            <input asp-for="DurationDays" class="form-control form-control-lg" type="number" min="1" max="365" 
                                   placeholder="30" />
                            <small class="form-text text-muted">How many days should this program run?</small>
                            <span asp-validation-for="DurationDays" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-arrow-left me-1"></i>Back to Workout Programs
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-1"></i>Create Program
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 