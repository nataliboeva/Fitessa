@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fitessa</title>

    <link href="https://fonts.googleapis.com/css?family=Muli:300,400,500,600,700,800,900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Oswald:300,400,500,600,700&display=swap" rel="stylesheet">

    <!-- Removed all Bootstrap and custom CSS links -->
    @RenderSection("Styles", required: false)
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f8fafc;
            margin: 0;
            padding: 0;
            color: #222;
        }
        header {
            background: #222;
            color: #fff;
            padding: 0.5rem 0;
            margin-bottom: 2rem;
        }
        .nav-menu ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            gap: 1.5rem;
            justify-content: center;
        }
        .nav-menu a {
            color: #fff;
            text-decoration: none;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            transition: background 0.2s;
        }
        .nav-menu a:hover, .nav-menu .active a {
            background: #4f8cff;
            color: #fff;
        }
        main {
            max-width: 900px;
            margin: 0 auto;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            padding: 2rem;
        }
        h1, h2, h3, h4 {
            color: #222;
        }
        a.btn, button, input[type=submit] {
            background: #4f8cff;
            color: #fff;
            border: none;
            border-radius: 4px;
            padding: 0.5rem 1.2rem;
            font-size: 1rem;
            cursor: pointer;
            text-decoration: none;
            margin: 0.2rem 0;
            transition: background 0.2s;
            display: inline-block;
        }
        a.btn:hover, button:hover, input[type=submit]:hover {
            background: #2563eb;
        }
        form {
            margin-bottom: 1.5rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
        }
        th, td {
            padding: 0.6rem 0.8rem;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }
        th {
            background: #f1f5f9;
        }
    </style>
</head>
<body>
    <header class="header-section">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-3">
                    <div class="logo">
                        
                    </div>
                </div>
                <div class="col-lg-6">
                    <nav class="nav-menu">
                        <ul>
                            <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"><a href="@Url.Action("Index", "Home")">Home</a></li>
                            <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                            <li><a href="@Url.Action("Index", "Exercises")">Exercises</a></li>
                            <li><a href="@Url.Action("Index", "WorkoutPrograms")">Workout Programs</a></li>
                            <li><a href="@Url.Action("Index", "SubscriptionPlans")">Plans</a></li>
                            <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a href="@Url.Action("Index", "Admin")">Admin</a></li>
                                    <li><a asp-controller="AdminSubscriptionPlans" asp-action="Index">Manage Plans</a></li>
                                }
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                        <button type="submit" class="logout-btn nav-link">Logout</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li><a asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                                <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                            }
                        </ul>
                    </nav>
                </div>
                <div class="col-lg-3">
                    <div class="top-option">
                        <div class="to-search search-switch">
                            <i class="fa fa-search"></i>
                        </div>
                        <div class="to-social">
                            <a href="#"><i class="fa fa-facebook"></i></a>
                            <a href="#"><i class="fa fa-twitter"></i></a>
                            <a href="#"><i class="fa fa-youtube-play"></i></a>
                            <a href="#"><i class="fa fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="canvas-open">
                <i class="fa fa-bars"></i>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/jquery-3.3.1.min.js"></script>
    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/bootstrap.min.js"></script>
    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/jquery.magnific-popup.min.js"></script>
    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/masonry.pkgd.min.js"></script>
    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/jquery.barfiller.js"></script>
    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/jquery.slicknav.js"></script>
    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/owl.carousel.min.js"></script>
    <script src="~/template-bootstrap/gymlife-master/gymlife-master/js/main.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
