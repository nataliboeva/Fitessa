<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fitessa</title>

    <link href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700,800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/template/css/fitness-theme.css" rel="stylesheet">
    <link href="~/css/dark-mode.css" rel="stylesheet">
    <link href="~/css/mobile-responsive.css" rel="stylesheet">
    
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Home")">
                <img src="~/images/logo/fitessa-logo.png" alt="Fitessa" class="navbar-logo me-2" onerror="this.style.display='none'">
                <span class="brand-text">Fitessa</span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                           href="@Url.Action("Index", "Home")">
                            <i class="fas fa-home me-1"></i>Home
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                               href="@Url.Action("Index", "Dashboard")">
                                <i class="fas fa-tachometer-alt me-1"></i>Dashboard
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Exercises")">
                            <i class="fas fa-running me-1"></i>Exercises
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "WorkoutPrograms")">
                            <i class="fas fa-dumbbell me-1"></i>Workouts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "MealPlans")">
                            <i class="fas fa-utensils me-1"></i>Meal Plans
                        </a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user me-1"></i>My Account
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("Index", "ProgressLog")">
                                    <i class="fas fa-chart-line me-2"></i>Progress Log
                                </a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Payment")">
                                    <i class="fas fa-credit-card me-2"></i>Payment
                                </a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Notification")">
                                    <i class="fas fa-bell me-2"></i>Notifications
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Profile")">
                                    <i class="fas fa-user-cog me-2"></i>Profile
                                </a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "Admin", new { area = "Admin" })">
                                        <i class="fas fa-shield-alt me-2"></i>Admin Dashboard
                                    </a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("Users", "Admin", new { area = "Admin" })">
                                        <i class="fas fa-users me-2"></i>Manage Users
                                    </a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("SystemStats", "Admin", new { area = "Admin" })">
                                        <i class="fas fa-chart-bar me-2"></i>Analytics
                                    </a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="@Url.Action("Logout", "Account")" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
                
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <button class="btn btn-link nav-link theme-toggle" onclick="toggleDarkMode()" title="Toggle Dark Mode">
                            <i class="fas fa-moon" id="themeIcon"></i>
                        </button>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="fas fa-user me-1"></i>@User.Identity.Name
                            </span>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Index", "Admin", new { area = "Admin" })">
                                    <i class="fas fa-shield-alt me-1"></i>Admin
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account")">
                                <i class="fas fa-sign-in-alt me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "Account")">
                                <i class="fas fa-user-plus me-1"></i>Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main style="padding-top: 80px;">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <img src="~/images/logo/fitessa-logo.png" alt="Fitessa" class="footer-logo me-2" onerror="this.style.display='none'">
                        <h5 class="mb-0">Fitessa</h5>
                    </div>
                    <p class="mb-3">Your personal fitness companion. Track workouts, manage meal plans, and achieve your fitness goals with our comprehensive platform.</p>
                    <div class="social-links">
                        <a href="#" title="Facebook"><i class="fab fa-facebook"></i></a>
                        <a href="#" title="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" title="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-md-2 mb-4">
                    <h6>Features</h6>
                    <ul class="list-unstyled">
                        <li><a href="@Url.Action("Index", "WorkoutPrograms")">Workout Programs</a></li>
                        <li><a href="@Url.Action("Index", "Exercises")">Exercise Library</a></li>
                        <li><a href="@Url.Action("Index", "MealPlans")">Meal Plans</a></li>

                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6>Support</h6>
                    <ul class="list-unstyled">
                        <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                        <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h6>Newsletter</h6>
                    <p class="mb-3">Stay updated with fitness tips and new features!</p>
                    <form class="d-flex">
                        <input type="email" class="form-control me-2" placeholder="Enter your email">
                        <button type="submit" class="btn btn-primary">Subscribe</button>
                    </form>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255,255,255,0.2);">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2024 Fitessa. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0">Made with <i class="fas fa-heart text-danger"></i> for fitness enthusiasts</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/template/js/fitness-theme.js"></script>
    <script src="~/js/dark-mode.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    @if (User.Identity.IsAuthenticated)
    {
        <script>
            var currentUserId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
        </script>
    }
    
    <div class="theme-customizer" style="position: fixed; top: 50%; right: -200px; transform: translateY(-50%); background: white; padding: 20px; border-radius: 10px 0 0 10px; box-shadow: -2px 0 10px rgba(0,0,0,0.1); transition: right 0.3s ease; z-index: 1000;">
        <h6 class="mb-3">Customize Theme</h6>
        <div class="mb-3">
            <label class="form-label">Primary Color</label>
            <input type="color" id="primaryColor" value="#ff6b35" class="form-control form-control-color">
        </div>
        <div class="mb-3">
            <label class="form-label">Secondary Color</label>
            <input type="color" id="secondaryColor" value="#2c3e50" class="form-control form-control-color">
        </div>
        <button class="btn btn-sm btn-primary" onclick="applyThemeColors()">Apply</button>
        <button class="btn btn-sm btn-secondary" onclick="resetThemeColors()">Reset</button>
    </div>
    
    <button class="btn btn-primary" onclick="toggleThemeCustomizer()" style="position: fixed; top: 50%; right: 0; transform: translateY(-50%); z-index: 1001; border-radius: 10px 0 0 10px; padding: 10px;">
        <i class="fas fa-palette"></i>
    </button>

    <script>
        function toggleThemeCustomizer() {
            const customizer = document.querySelector('.theme-customizer');
            customizer.style.right = customizer.style.right === '0px' ? '-200px' : '0px';
        }
        
        function applyThemeColors() {
            const primaryColor = document.getElementById('primaryColor').value;
            const secondaryColor = document.getElementById('secondaryColor').value;
            if (window.FitessaTheme) {
                window.FitessaTheme.updateThemeColors(primaryColor, secondaryColor);
            }
        }
        
        function resetThemeColors() {
            document.getElementById('primaryColor').value = '#ff6b35';
            document.getElementById('secondaryColor').value = '#2c3e50';
            applyThemeColors();
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
