@{
    ViewData["Title"] = "About Fitessa";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="mb-0"><i class="fas fa-info-circle me-2"></i>About Fitessa</h1>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h3>Our Mission</h3>
                            <p class="lead">Transform your fitness journey with personalized workout programs, nutrition guidance, and progress tracking.</p>
                            <p>Fitessa is your comprehensive fitness companion designed to help you achieve your health and wellness goals. Whether you're a beginner starting your fitness journey or an experienced athlete looking to optimize your performance, our platform provides the tools and guidance you need.</p>
                        </div>
                        <div class="col-md-6 text-center">
                            <i class="fas fa-dumbbell text-primary" style="font-size: 8rem; opacity: 0.3;"></i>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <h3>What We Offer</h3>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <div class="text-center">
                                        <i class="fas fa-dumbbell text-primary mb-3" style="font-size: 3rem;"></i>
                                        <h5>Workout Programs</h5>
                                        <p>Personalized workout routines designed for your fitness level and goals.</p>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="text-center">
                                        <i class="fas fa-utensils text-success mb-3" style="font-size: 3rem;"></i>
                                        <h5>Nutrition Plans</h5>
                                        <p>Balanced meal plans that complement your fitness journey and dietary preferences.</p>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <div class="text-center">
                                        <i class="fas fa-chart-line text-info mb-3" style="font-size: 3rem;"></i>
                                        <h5>Progress Tracking</h5>
                                        <p>Monitor your progress with detailed analytics and visual progress indicators.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <h3>Our Features</h3>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex align-items-center">
                                    <i class="fas fa-check-circle text-success me-3"></i>
                                    <span>Personalized workout recommendations based on your fitness level</span>
                                </li>
                                <li class="list-group-item d-flex align-items-center">
                                    <i class="fas fa-check-circle text-success me-3"></i>
                                    <span>Comprehensive exercise library with detailed instructions</span>
                                </li>
                                <li class="list-group-item d-flex align-items-center">
                                    <i class="fas fa-check-circle text-success me-3"></i>
                                    <span>Nutrition tracking and meal plan customization</span>
                                </li>
                                <li class="list-group-item d-flex align-items-center">
                                    <i class="fas fa-check-circle text-success me-3"></i>
                                    <span>Real-time progress monitoring and analytics</span>
                                </li>
                                <li class="list-group-item d-flex align-items-center">
                                    <i class="fas fa-check-circle text-success me-3"></i>
                                    <span>Mobile-responsive design for on-the-go access</span>
                                </li>
                                <li class="list-group-item d-flex align-items-center">
                                    <i class="fas fa-check-circle text-success me-3"></i>
                                    <span>Export workout and meal plans to PDF</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 text-center">
                            <h3>Ready to Start Your Journey?</h3>
                            <p class="lead mb-4">Join thousands of users who have transformed their lives with Fitessa.</p>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg me-3">
                                <i class="fas fa-user-plus me-2"></i>Get Started
                            </a>
                            <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-envelope me-2"></i>Contact Us
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 