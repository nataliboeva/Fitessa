@model Fitessa.Data.Entities.MeasurementLog
@{
    ViewData["Title"] = "Add Progress Log";
}
<h2>Add Progress Log</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="WeightKg"></label>
        <input asp-for="WeightKg" class="form-control" type="number" step="0.1" />
        <span asp-validation-for="WeightKg" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="HeightCm"></label>
        <input asp-for="HeightCm" class="form-control" type="number" />
        <span asp-validation-for="HeightCm" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Add</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 