@model Fitessa.Data.Entities.MeasurementLog
@{
    ViewData["Title"] = "Add Progress Log";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-chart-line me-2"></i>
                        Log Your Progress
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="WeightKg" class="form-label fw-bold">
                                        <i class="fas fa-weight me-1"></i>Weight (kg)
                                    </label>
                                    <input asp-for="WeightKg" class="form-control form-control-lg" 
                                           type="number" step="0.1" min="30" max="300" 
                                           placeholder="70.5" />
                                    <small class="form-text text-muted">Enter your current weight in kilograms</small>
                                    <span asp-validation-for="WeightKg" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="HeightCm" class="form-label fw-bold">
                                        <i class="fas fa-ruler-vertical me-1"></i>Height (cm)
                                    </label>
                                    <input asp-for="HeightCm" class="form-control form-control-lg" 
                                           type="number" min="100" max="250" 
                                           placeholder="175" />
                                    <small class="form-text text-muted">Enter your height in centimeters</small>
                                    <span asp-validation-for="HeightCm" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Tip:</strong> Regular progress tracking helps you stay motivated and see your fitness journey progress over time. 
                            Try to log your measurements at the same time of day for consistency.
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-arrow-left me-1"></i>Back to Progress Log
                            </a>
                            <button type="submit" class="btn btn-info btn-lg">
                                <i class="fas fa-save me-1"></i>Save Progress
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 