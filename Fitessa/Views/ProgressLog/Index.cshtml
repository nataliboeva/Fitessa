@model IEnumerable<Fitessa.Data.Entities.MeasurementLog>
@{
    ViewData["Title"] = "Progress Log";
    var logs = Model.OrderBy(l => l.LoggedAt).ToList();
    var weights = string.Join(",", logs.Select(l => l.WeightKg));
    var dates = string.Join(",", logs.Select(l => $"'" + l.LoggedAt.ToString("yyyy-MM-dd") + "'"));
}
<h2>Progress Log</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Add New Log</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Weight (kg)</th>
            <th>Height (cm)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var log in logs)
    {
        <tr>
            <td>@log.LoggedAt.ToString("yyyy-MM-dd")</td>
            <td>@log.WeightKg</td>
            <td>@log.HeightCm</td>
            <td>
                <a asp-action="Edit" asp-route-id="@log.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@log.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<hr />
<h3>Weight Progress Chart</h3>
<canvas id="weightChart" width="600" height="300"></canvas>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('weightChart').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [@Html.Raw(dates)],
                datasets: [{
                    label: 'Weight (kg)',
                    data: [@weights],
                    borderColor: 'rgba(54, 162, 235, 1)',
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    fill: true,
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
} 