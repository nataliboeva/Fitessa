@model Fitessa.Data.Entities.MeasurementLog
@{
    ViewData["Title"] = "Delete Progress Log";
}
<h2>Delete Progress Log</h2>
<h3>Are you sure you want to delete this entry?</h3>
<div>
    <div><strong>Date:</strong> @Model.LoggedAt.ToString("yyyy-MM-dd")</div>
    <div><strong>Weight (kg):</strong> @Model.WeightKg</div>
    <div><strong>Height (cm):</strong> @Model.HeightCm</div>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form> 