@model Fitessa.Data.Entities.MealPlan
@{
    ViewData["Title"] = "Create Meal Plan";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-utensils me-2"></i>
                        Create New Meal Plan
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label fw-bold">
                                <i class="fas fa-tag me-1"></i>Meal Plan Name
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg" 
                                   placeholder="Enter meal plan name..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-bold">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="6" 
                                      placeholder="Describe your meal plan goals, dietary preferences, calorie targets, and any specific nutritional requirements..."></textarea>
                            <small class="form-text text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Include information about meal timing, portion sizes, and any dietary restrictions.
                            </small>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-arrow-left me-1"></i>Back to Meal Plans
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save me-1"></i>Create Meal Plan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 