@model IEnumerable<Fitessa.Data.Entities.MealPlan>
@{
    ViewData["Title"] = "Meal Plans";
}
<h2>Meal Plans</h2>
<p>
    <a href="@Url.Action("Create")" class="btn">Create New Meal Plan</a>
</p>
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                <a href="@Url.Action("Edit", new { id = item.Id })">Edit</a> |
                <a href="@Url.Action("Delete", new { id = item.Id })">Delete</a> |
                <a href="@Url.Action("ExportToPdf", new { id = item.Id })" class="btn">Export to PDF</a>
            </td>
        </tr>
    }
    </tbody>
</table> 