@model IEnumerable<Fitessa.Data.Entities.Exercise>

@{
    ViewData["Title"] = "Exercises";
    var muscleGroups = ViewBag.MuscleGroups as List<string>;
    var difficulties = ViewBag.Difficulties as List<string>;
    var query = ViewContext.HttpContext.Request.Query;
    string selectedMuscleGroup = query["muscleGroup"];
    string selectedDifficulty = query["difficulty"];
    string searchValue = query["search"];
}

<h1>Exercises</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="search" value="@searchValue" class="form-control" placeholder="Search by name or description" />
    </div>
    <div class="col-md-3">
        <select name="muscleGroup" class="form-select">
            <option value="">All Muscle Groups</option>
            @if (muscleGroups != null)
            {
                foreach (var mg in muscleGroups)
                {
                    @:<option value="@mg"@(mg == selectedMuscleGroup ? " selected" : "")>@mg</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="difficulty" class="form-select">
            <option value="">All Difficulties</option>
            @if (difficulties != null)
            {
                foreach (var d in difficulties)
                {
                    @:<option value="@d"@(d == selectedDifficulty ? " selected" : "")>@d</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Muscle Group</th>
            <th>Difficulty Level</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var exercise in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@exercise.Id">@exercise.Name</a></td>
            <td>@exercise.Description</td>
            <td>@exercise.MuscleGroup</td>
            <td>@exercise.DifficultyLevel</td>
        </tr>
    }
    </tbody>
</table>

@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalItems = ViewBag.TotalItems ?? 0;
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
}
@if (totalPages > 1)
{
    <nav aria-label="Exercise pagination">
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?@queryStringWithPage(1)">First</a>
            </li>
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?@queryStringWithPage(currentPage - 1)">Previous</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?@queryStringWithPage(i)">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="?@queryStringWithPage(currentPage + 1)">Next</a>
            </li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="?@queryStringWithPage(totalPages)">Last</a>
            </li>
        </ul>
    </nav>
}

@functions {
    private string queryStringWithPage(int page)
    {
        var query = new System.Text.StringBuilder();
        var request = ViewContext.HttpContext.Request;
        foreach (var key in request.Query.Keys)
        {
            if (key != "page")
            {
                foreach (var value in request.Query[key])
                {
                    query.Append($"{key}={System.Net.WebUtility.UrlEncode(value)}&");
                }
            }
        }
        query.Append($"page={page}");
        return query.ToString();
    }
} 