@model Fitessa.Data.Entities.Exercise
@{
    ViewData["Title"] = "Delete Exercise";
}
<h2>Delete Exercise</h2>
<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>@Model.Name</h4>
    <div><strong>Description:</strong> @Model.Description</div>
    <div><strong>Muscle Group:</strong> @Model.MuscleGroup</div>
    <div><strong>Difficulty:</strong> @Model.DifficultyLevel</div>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form> 