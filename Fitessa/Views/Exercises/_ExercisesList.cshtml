@model IEnumerable<Fitessa.Data.Entities.Exercise>

<div class="row">
    @foreach (var exercise in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 exercise-card">
                <div class="card-body">
                    <h5 class="card-title">@exercise.Name</h5>
                    <p class="card-text">@exercise.Description</p>
                    <div class="exercise-meta">
                        <span class="badge bg-primary me-2">@exercise.MuscleGroup</span>
                        <span class="badge bg-secondary">@exercise.DifficultyLevel</span>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Details", "Exercises", new { id = exercise.Id })" 
                       class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-info-circle me-1"></i>Details
                    </a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Edit", "Exercises", new { id = exercise.Id })" 
                           class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-search fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">No exercises found</h5>
        <p class="text-muted">Try adjusting your search criteria</p>
    </div>
} 