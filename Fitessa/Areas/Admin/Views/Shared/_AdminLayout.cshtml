<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fitessa Admin</title>

    <link href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700,800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/admin-theme.css" rel="stylesheet">
    <link href="~/css/dark-mode.css" rel="stylesheet">
    
    @RenderSection("Styles", required: false)
</head>
<body class="admin-body">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="border-right" id="sidebar-wrapper">
            <div class="sidebar-heading">
                <i class="fas fa-shield-alt me-2"></i>Fitessa Admin
            </div>
            <div class="list-group list-group-flush">
                <a href="@Url.Action("Index", "Admin", new { area = "Admin" })" class="list-group-item list-group-item-action">
                    <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                </a>
                <a href="@Url.Action("Users", "Admin", new { area = "Admin" })" class="list-group-item list-group-item-action">
                    <i class="fas fa-users me-2"></i>Users
                </a>
                <a href="@Url.Action("SystemStats", "Admin", new { area = "Admin" })" class="list-group-item list-group-item-action">
                    <i class="fas fa-chart-bar me-2"></i>Analytics
                </a>
                <a href="@Url.Action("Index", "WorkoutPrograms")" class="list-group-item list-group-item-action">
                    <i class="fas fa-dumbbell me-2"></i>Workout Programs
                </a>
                <a href="@Url.Action("Index", "Exercises")" class="list-group-item list-group-item-action">
                    <i class="fas fa-running me-2"></i>Exercises
                </a>
                <a href="@Url.Action("Index", "MealPlans")" class="list-group-item list-group-item-action">
                    <i class="fas fa-utensils me-2"></i>Meal Plans
                </a>
                <a href="@Url.Action("Index", "SubscriptionPlans")" class="list-group-item list-group-item-action">
                    <i class="fas fa-crown me-2"></i>Subscription Plans
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <button class="btn btn-primary" id="menu-toggle">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="navbar-nav ml-auto mt-2 mt-lg-0">
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-user me-1"></i>@User.Identity?.Name
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Home")">
                                <i class="fas fa-home me-2"></i>Back to Main Site
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form action="@Url.Action("Logout", "Account")" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-scripts.js"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html> 