@model List<Fitessa.Models.AdminUserViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">User Management</h1>
        <div>
            <input type="text" class="form-control d-inline-block w-auto me-2" 
                   placeholder="Search users..." id="userSearch" data-table="usersTable">
            <button class="btn btn-success btn-sm" onclick="exportTableToCSV('usersTable', 'users.csv')">
                <i class="fas fa-download"></i> Export
            </button>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">All Users</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="usersTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="sortable" style="cursor: pointer;">
                                <i class="fas fa-sort"></i> Name
                            </th>
                            <th class="sortable" style="cursor: pointer;">
                                <i class="fas fa-sort"></i> Email
                            </th>
                            <th class="sortable" style="cursor: pointer;">
                                <i class="fas fa-sort"></i> Status
                            </th>
                            <th class="sortable" style="cursor: pointer;">
                                <i class="fas fa-sort"></i> Role
                            </th>
                            <th class="sortable" style="cursor: pointer;">
                                <i class="fas fa-sort"></i> Created
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FirstName @user.LastName</td>
                                <td>@user.Email</td>
                                <td>
                                                    <span class="badge @(!user.IsBanned ? "badge-success" : "badge-danger")">
                    @(!user.IsBanned ? "Active" : "Banned")
                </span>
                                </td>
                                <td>
                                    <span class="badge badge-info">@user.Role</span>
                                </td>
                                <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("UserDetails", "Admin", new { area = "Admin", id = user.Id })" 
                                           class="btn btn-sm btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form action="@Url.Action("ToggleUserStatus", "Admin", new { area = "Admin" })" 
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                                                    <button type="submit" class="btn btn-sm @(!user.IsBanned ? "btn-warning" : "btn-success")"
                                title="@(!user.IsBanned ? "Ban" : "Unban") User">
                            <i class="fas @(!user.IsBanned ? "fa-user-slash" : "fa-user-check")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
function exportTableToCSV(tableId, filename) {
    const table = document.getElementById(tableId);
    const csv = [];
    const rows = table.querySelectorAll('tr');
    
    for (let i = 0; i < rows.length; i++) {
        const row = [], cols = rows[i].querySelectorAll('td, th');
        
        for (let j = 0; j < cols.length; j++) {
            let text = cols[j].innerText.replace(/,/g, ';');
            row.push('"' + text + '"');
        }
        
        csv.push(row.join(','));
    }
    
    const csvContent = csv.join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    
    if (link.download !== undefined) {
        const url = URL.createObjectURL(blob);
        link.setAttribute('href', url);
        link.setAttribute('download', filename);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
}
</script> 